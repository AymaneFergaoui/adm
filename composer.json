{
    "name": "drupal/amisdesmusees",
    "description": "Project template for Drupal projects for Amis Des Musees Luxembourg",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "N.AMBROISE",
            "role": "IT Senior Officer"
        }
    ],
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^1.9 || ^2.0",
        "drupal/address": "^2.0",
        "drupal/addtoany": "^2.0",
        "drupal/addtocalendar": "^3.4",
        "drupal/admin_toolbar": "^3.4",
        "drupal/advagg": "^6.0@alpha",
        "drupal/ajax_loader": "^2.1",
        "drupal/anchor_link": "^2.7",
        "drupal/antibot": "^2.0",
        "drupal/autoban": "^1.10",
        "drupal/backup_migrate": "^5.0",
        "drupal/bartik": "^1.0",
        "drupal/block_content_permissions": "^1.11",
        "drupal/block_region_permissions": "^1.5",
        "drupal/bootstrap_barrio": "^5.5",
        "drupal/bootstrap_library": "^2.0",
        "drupal/captcha": "^2.0",
        "drupal/chosen": "^3.0 || ^4.0 || ^5.0",
        "drupal/ckeditor": "^1.0",
        "drupal/classy": "^1.0",
        "drupal/classy_paragraphs": "^1.0@RC || ^2.0",
        "drupal/color": "^1.0",
        "drupal/commerce": "^2.40",
        "drupal/commerce_cart_redirection": "^3.2",
        "drupal/commerce_shipping": "^2.8",
        "drupal/commerce_stripe": "^1.4",
        "drupal/convert_bundles": "^2.0@beta",
        "drupal/core": "~10.2.0 || ~10.3.0",
        "drupal/core-composer-scaffold": "~10.2.0 || ~10.3.0",
        "drupal/core-project-message": "~10.2.0 || ~10.3.0",
        "drupal/core-recommended": "~10.2.0 || ~10.3.0",
        "drupal/ctools": "^3.14 || ^4.0",
        "drupal/entity": "^1.4",
        "drupal/entity_reference_revisions": "^1.11",
        "drupal/eu_cookie_compliance": "^1.24",
        "drupal/fakeobjects": "^1.2",
        "drupal/field_group": "^3.6",
        "drupal/file_upload_secure_validator": "^2.1",
        "drupal/fontawesome": "^2.25",
        "drupal/fullcalendar_view": "^5.1",
        "drupal/gdoc_field": "^1.4",
        "drupal/google_analytics": "^4.0",
        "drupal/honeypot": "^2.1",
        "drupal/imagefield_slideshow": "^2.0",
        "drupal/imce": "^3.0",
        "drupal/inline_entity_form": "^1.0@RC || ^3.0",
        "drupal/jquery_ui_accordion": "^2.0",
        "drupal/mailgun": "^2.0",
        "drupal/mailsystem": "^4.4",
        "drupal/menu_link_attributes": "^1.3",
        "drupal/metatag": "^1.26 || ^2.0",
        "drupal/override_node_options": "^2.8",
        "drupal/pagerer": "^3.1",
        "drupal/paragraphs": "^1.16",
        "drupal/parallax_bg": "^2.0@alpha",
        "drupal/pathauto": "^1.12",
        "drupal/physical": "^1.3",
        "drupal/profile": "^1.8",
        "drupal/pwa": "^2.1@beta",
        "drupal/rdf": "^2.1",
        "drupal/recaptcha": "^3.2",
        "drupal/redirect": "^1.9",
        "drupal/responsive_favicons": "^2.0 || ^4.0",
        "drupal/role_delegation": "^1.2",
        "drupal/role_expire": "^3.0 || ^4.0",
        "drupal/schema_metatag": "^2.5 || ^3.0",
        "drupal/search404": "^2.1",
        "drupal/search_api": "^1.29",
        "drupal/seven": "^1.0@beta",
        "drupal/simple_gmap": "^3.1 || ^4.0",
        "drupal/simple_popup_blocks": "^3.1",
        "drupal/simple_sitemap": "^4.1",
        "drupal/socialfeed": "^3.0@alpha || ^4.0",
        "drupal/stable": "^2.0",
        "drupal/state_machine": "^1.10",
        "drupal/taxonomy_import": "^2.0",
        "drupal/token": "^1.13",
        "drupal/token_filter": "^2.1",
        "drupal/views_conditional": "^1.9",
        "drupal/views_slideshow": "^5.0",
        "drupal/webform": "^6.2",
        "drush/drush": "^11.0 || ^12.0"
    },
    "require-dev": {},
    "conflict": {
        "drupal/drupal": "*"
    },
    "replace": {
        "drupal/toolbar": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "discard-changes": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "."
            }
        },
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": [],
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "drush/Commands/{$name}": [
                "type:drupal-drush"
            ],
            "core": [
                "type:drupal-core"
            ],
            "modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ]
        }
    }
}
