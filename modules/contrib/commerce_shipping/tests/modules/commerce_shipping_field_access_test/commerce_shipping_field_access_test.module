<?php

/**
 * @file
 * Adds a restricted shipment field, as other modules do.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_entity_base_field_info().
 */
function commerce_shipping_field_access_test_entity_base_field_info(EntityTypeInterface $entity_type) {
  $fields = [];
  if ($entity_type->id() === 'commerce_shipment') {
    $fields['test_restricted_field'] = BaseFieldDefinition::create('string')
      ->setLabel(t('Test restricted field'));
  }
  return $fields;
}

/**
 * Implements hook_entity_type_build().
 */
function commerce_shipping_field_access_test_entity_type_build(array &$entity_types) {
  $restricted_fields = $entity_types['commerce_shipment']->get('restricted_fields') ?? [];
  $entity_types['commerce_shipment']->set('restricted_fields', array_merge($restricted_fields, ['test_restricted_field']));
}

/**
 * Implements hook_entity_field_access().
 */
function commerce_shipping_field_access_test_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL) {
  if ($operation === 'edit' && $field_definition->getName() === 'test_restricted_field') {
    // Modules can grant access to restricted fields.
    return AccessResult::allowedIfHasPermission($account, 'edit test restricted field');
  }
  return AccessResult::neutral();
}
